generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model accounts {
  id                  String  @id
  user_id             Int
  type                String
  provider            String
  provider_account_id String
  refresh_token       String? @db.Text
  access_token        String? @db.Text
  expires_at          Int?
  token_type          String?
  scope               String?
  id_token            String? @db.Text
  session_state       String?
  users               users   @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([provider, provider_account_id])
  @@index([user_id], map: "accounts_user_id_fkey")
}

model completed_deeds {
  id                    Int                    @id @default(autoincrement())
  user_id               Int
  good_deed_id          Int?
  custom_deed_name      String?                @db.VarChar(200)
  base_points           Int                    @default(10)
  bonus_points          Int                    @default(0)
  multiplier            Decimal                @default(1.00) @db.Decimal(3, 2)
  total_points          Int
  completed_at          DateTime               @default(now())
  date                  DateTime               @db.Date
  notes                 String?                @db.Text
  is_streak_bonus       Boolean                @default(false)
  is_power_day          Boolean                @default(false)
  predefined_good_deeds predefined_good_deeds? @relation(fields: [good_deed_id], references: [id])
  users                 users                  @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([date])
  @@index([good_deed_id], map: "completed_deeds_good_deed_id_fkey")
  @@index([user_id, date])
}

model countries {
  id        Int         @id @default(autoincrement())
  name_en   String      @db.VarChar(100)
  name_bn   String?     @db.VarChar(100)
  name_ar   String?     @db.VarChar(100)
  code      String      @unique @db.VarChar(3)
  divisions divisions[]
  users     users[]
}

model districts {
  id          Int       @id @default(autoincrement())
  division_id Int
  name_en     String    @db.VarChar(100)
  name_bn     String?   @db.VarChar(100)
  name_ar     String?   @db.VarChar(100)
  latitude    Decimal?  @db.Decimal(10, 8)
  longitude   Decimal?  @db.Decimal(11, 8)
  divisions   divisions @relation(fields: [division_id], references: [id])
  users       users[]

  @@index([division_id])
  @@index([latitude, longitude])
}

model divisions {
  id         Int         @id @default(autoincrement())
  country_id Int
  name_en    String      @db.VarChar(100)
  name_bn    String?     @db.VarChar(100)
  name_ar    String?     @db.VarChar(100)
  districts  districts[]
  countries  countries   @relation(fields: [country_id], references: [id])
  users      users[]

  @@index([country_id])
}

model gold_silver_prices {
  id                Int      @id @default(autoincrement())
  gold_per_22k_gram Decimal  @db.Decimal(12, 2)
  gold_per_24k_gram Decimal  @db.Decimal(12, 2)
  gold_per_21k_gram Decimal  @db.Decimal(12, 2)
  gold_per_18k_gram Decimal  @db.Decimal(12, 2)
  silver_per_gram   Decimal  @db.Decimal(10, 2)
  currency          String   @default("'BDT'") @db.VarChar(5)
  source            String   @default("'BAJUS'") @db.VarChar(50)
  is_manual         Boolean  @default(false)
  fetched_at        DateTime @default(now())
}

model leaderboard_cache {
  id           Int      @id @default(autoincrement())
  user_id      Int
  period       String   @db.VarChar(20)
  scope_type   String   @db.VarChar(20)
  scope_id     Int?
  total_points Int      @default(0)
  rank         Int?
  date         DateTime @db.Date
  last_updated DateTime @default(now())
  users        users    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, period, scope_type, scope_id, date])
  @@index([period, scope_type, scope_id, rank])
}

model notification_preferences {
  id                     Int      @id @default(autoincrement())
  user_id                Int      @unique
  fajr_reminder          Boolean  @default(true)
  dhuhr_reminder         Boolean  @default(true)
  asr_reminder           Boolean  @default(true)
  maghrib_reminder       Boolean  @default(true)
  isha_reminder          Boolean  @default(true)
  leaderboard_motivation Boolean  @default(true)
  leaderboard_hour       Int      @default(20)
  leaderboard_minute     Int      @default(0)
  created_at             DateTime @default(now())
  updated_at             DateTime
  users                  users    @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model prayer_settings {
  id                   Int     @id @default(autoincrement())
  user_id              Int     @unique
  calculation_method   String  @default("'Karachi'") @db.VarChar(20)
  juristic_method      String  @default("'Hanafi'") @db.VarChar(20)
  enable_notifications Boolean @default(true)
  users                users   @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model predefined_good_deeds {
  id                    Int               @id @default(autoincrement())
  name_en               String            @db.VarChar(100)
  name_bn               String?           @db.VarChar(100)
  name_ar               String?           @db.VarChar(100)
  category              String            @default("'other'") @db.VarChar(50)
  tier                  String            @default("'easy'") @db.VarChar(20)
  points                Int               @default(10)
  time_estimate_minutes Int?
  icon                  String?           @db.VarChar(50)
  is_active             Boolean           @default(true)
  display_order         Int               @default(0)
  description_en        String?           @db.Text
  description_bn        String?           @db.Text
  description_ar        String?           @db.Text
  category_ar           String?           @db.VarChar(100)
  category_bn           String?           @db.VarChar(100)
  category_en           String?           @db.VarChar(100)
  completed_deeds       completed_deeds[]
  user_goals            user_goals[]
}

model push_subscriptions {
  id         Int      @id @default(autoincrement())
  user_id    Int
  token      String   @unique @db.VarChar(512)
  created_at DateTime @default(now())
  updated_at DateTime
  users      users    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
}

model system_settings {
  id                               Int      @id @default(autoincrement())
  slack_webhook_url                String?  @db.Text
  notify_on_register               Boolean  @default(true)
  notify_on_login                  Boolean  @default(true)
  notify_on_visit                  Boolean  @default(false)
  updated_at                       DateTime
  global_leaderboard_notifications Boolean  @default(true)
  global_prayer_notifications      Boolean  @default(true)
}

model user_goals {
  id                    Int                    @id @default(autoincrement())
  user_id               Int
  good_deed_id          Int?
  custom_deed_name      String?                @db.VarChar(200)
  goal_type             String                 @db.VarChar(20)
  target_count          Int                    @default(1)
  start_date            DateTime               @db.Date
  end_date              DateTime               @db.Date
  is_completed          Boolean                @default(false)
  created_at            DateTime               @default(now())
  predefined_good_deeds predefined_good_deeds? @relation(fields: [good_deed_id], references: [id])
  users                 users                  @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([good_deed_id], map: "user_goals_good_deed_id_fkey")
  @@index([user_id, goal_type, start_date])
}

model users {
  id                       Int                       @id @default(autoincrement())
  email                    String                    @unique @db.VarChar(255)
  name                     String                    @db.VarChar(100)
  phone                    String?                   @db.VarChar(20)
  image                    String?                   @db.Text
  country_id               Int?
  division_id              Int?
  district_id              Int?
  preferred_language       String                    @default("'en'") @db.VarChar(5)
  timezone                 String                    @default("'Asia/Dhaka'") @db.VarChar(50)
  created_at               DateTime                  @default(now())
  updated_at               DateTime
  city_name                String?                   @default("'Dhaka'") @db.VarChar(100)
  country_name             String?                   @default("'Bangladesh'") @db.VarChar(100)
  last_active_at           DateTime?
  last_login_at            DateTime?
  email_verified           Boolean                   @default(false)
  password_hash            String?                   @db.Text
  accounts                 accounts[]
  completed_deeds          completed_deeds[]
  leaderboard_cache        leaderboard_cache[]
  notification_preferences notification_preferences?
  prayer_settings          prayer_settings?
  push_subscriptions       push_subscriptions[]
  user_goals               user_goals[]
  countries                countries?                @relation(fields: [country_id], references: [id])
  districts                districts?                @relation(fields: [district_id], references: [id])
  divisions                divisions?                @relation(fields: [division_id], references: [id])

  @@index([country_id, division_id, district_id])
  @@index([district_id], map: "users_district_id_fkey")
  @@index([division_id], map: "users_division_id_fkey")
  @@index([email])
}

model verification_tokens {
  id         Int      @id @default(autoincrement())
  email      String   @db.VarChar(255)
  token      String   @unique @db.VarChar(255)
  expires_at DateTime
  created_at DateTime @default(now())

  @@index([email])
}
