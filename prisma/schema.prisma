generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id
  userId            Int     @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refreshToken      String? @map("refresh_token") @db.Text
  accessToken       String? @map("access_token") @db.Text
  expiresAt         Int?    @map("expires_at")
  tokenType         String? @map("token_type")
  scope             String?
  idToken           String? @map("id_token") @db.Text
  sessionState      String? @map("session_state")
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId], map: "accounts_user_id_fkey")
  @@map("accounts")
}

model CompletedDeed {
  id                 Int                   @id @default(autoincrement())
  userId             Int                   @map("user_id")
  goodDeedId         Int?                  @map("good_deed_id")
  customDeedName     String?               @map("custom_deed_name") @db.VarChar(200)
  basePoints         Int                   @default(10) @map("base_points")
  bonusPoints        Int                   @default(0) @map("bonus_points")
  multiplier         Decimal               @default(1.00) @db.Decimal(3, 2)
  totalPoints        Int                   @map("total_points")
  completedAt        DateTime              @default(now()) @map("completed_at")
  date               DateTime              @db.Date
  notes              String?               @db.Text
  isStreakBonus      Boolean               @default(false) @map("is_streak_bonus")
  isPowerDay         Boolean               @default(false) @map("is_power_day")
  predefinedGoodDeed PredefinedGoodDeed?   @relation(fields: [goodDeedId], references: [id])
  user               User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  referralRewards    ReferralReward[]

  @@index([date])
  @@index([goodDeedId], map: "completed_deeds_good_deed_id_fkey")
  @@index([userId, date])
  @@map("completed_deeds")
}

model Country {
  id        Int        @id @default(autoincrement())
  nameEn    String     @map("name_en") @db.VarChar(100)
  nameBn    String?    @map("name_bn") @db.VarChar(100)
  nameAr    String?    @map("name_ar") @db.VarChar(100)
  code      String     @unique @db.VarChar(3)
  divisions Division[]
  users     User[]

  @@map("countries")
}

model District {
  id         Int      @id @default(autoincrement())
  divisionId Int      @map("division_id")
  nameEn     String   @map("name_en") @db.VarChar(100)
  nameBn     String?  @map("name_bn") @db.VarChar(100)
  nameAr     String?  @map("name_ar") @db.VarChar(100)
  latitude   Decimal? @db.Decimal(10, 8)
  longitude  Decimal? @db.Decimal(11, 8)
  division   Division @relation(fields: [divisionId], references: [id])
  users      User[]

  @@index([divisionId])
  @@index([latitude, longitude])
  @@map("districts")
}

model Division {
  id        Int        @id @default(autoincrement())
  countryId Int        @map("country_id")
  nameEn    String     @map("name_en") @db.VarChar(100)
  nameBn    String?    @map("name_bn") @db.VarChar(100)
  nameAr    String?    @map("name_ar") @db.VarChar(100)
  districts District[]
  country   Country    @relation(fields: [countryId], references: [id])
  users     User[]

  @@index([countryId])
  @@map("divisions")
}

model GoldSilverPrice {
  id             Int      @id @default(autoincrement())
  gold22kGram    Decimal  @map("gold_per_22k_gram") @db.Decimal(12, 2)
  gold24kGram    Decimal  @map("gold_per_24k_gram") @db.Decimal(12, 2)
  gold21kGram    Decimal  @map("gold_per_21k_gram") @db.Decimal(12, 2)
  gold18kGram    Decimal  @map("gold_per_18k_gram") @db.Decimal(12, 2)
  silverPerGram  Decimal  @map("silver_per_gram") @db.Decimal(10, 2)
  currency       String   @default("BDT") @db.VarChar(5)
  source         String   @default("BAJUS") @db.VarChar(50)
  isManual       Boolean  @default(false) @map("is_manual")
  fetchedAt      DateTime @default(now()) @map("fetched_at")

  @@map("gold_silver_prices")
}

model LeaderboardCache {
  id          Int      @id @default(autoincrement())
  userId      Int      @map("user_id")
  period      String   @db.VarChar(20)
  scopeType   String   @map("scope_type") @db.VarChar(20)
  scopeId     Int?     @map("scope_id")
  totalPoints Int      @default(0) @map("total_points")
  rank        Int?
  date        DateTime @db.Date
  lastUpdated DateTime @default(now()) @map("last_updated")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, period, scopeType, scopeId, date])
  @@index([period, scopeType, scopeId, rank])
  @@map("leaderboard_cache")
}

model NotificationPreferences {
  id                    Int      @id @default(autoincrement())
  userId                Int      @unique @map("user_id")
  fajrReminder          Boolean  @default(true) @map("fajr_reminder")
  dhuhrReminder         Boolean  @default(true) @map("dhuhr_reminder")
  asrReminder           Boolean  @default(true) @map("asr_reminder")
  maghribReminder       Boolean  @default(true) @map("maghrib_reminder")
  ishaReminder          Boolean  @default(true) @map("isha_reminder")
  prayerReminder        Boolean  @default(true) @map("prayer_reminder")
  leaderboardMotivation Boolean  @default(true) @map("leaderboard_motivation")
  leaderboardHour       Int      @default(20) @map("leaderboard_hour")
  leaderboardMinute     Int      @default(0) @map("leaderboard_minute")
  quizReminder          Boolean  @default(true) @map("quiz_reminder")
  quizHour              Int      @default(8) @map("quiz_hour")
  quizMinute            Int      @default(0) @map("quiz_minute")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

model PrayerSettings {
  id                  Int     @id @default(autoincrement())
  userId              Int     @unique @map("user_id")
  calculationMethod   String  @default("Karachi") @map("calculation_method") @db.VarChar(20)
  juristicMethod      String  @default("Hanafi") @map("juristic_method") @db.VarChar(20)
  enableNotifications Boolean @default(true) @map("enable_notifications")
  user                User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("prayer_settings")
}

model PredefinedGoodDeed {
  id                  Int               @id @default(autoincrement())
  nameEn              String            @map("name_en") @db.VarChar(100)
  nameBn              String?           @map("name_bn") @db.VarChar(100)
  nameAr              String?           @map("name_ar") @db.VarChar(100)
  category            String            @default("other") @db.VarChar(50)
  tier                String            @default("easy") @db.VarChar(20)
  points              Int               @default(10)
  timeEstimateMinutes Int?              @map("time_estimate_minutes")
  icon                String?           @db.VarChar(50)
  isActive            Boolean           @default(true) @map("is_active")
  displayOrder        Int               @default(0) @map("display_order")
  descriptionEn       String?           @map("description_en") @db.Text
  descriptionBn       String?           @map("description_bn") @db.Text
  descriptionAr       String?           @map("description_ar") @db.Text
  categoryAr          String?           @map("category_ar") @db.VarChar(100)
  categoryBn          String?           @map("category_bn") @db.VarChar(100)
  categoryEn          String?           @map("category_en") @db.VarChar(100)
  completedDeeds      CompletedDeed[]
  userGoals           UserGoal[]

  @@map("predefined_good_deeds")
}

model PushSubscription {
  id          Int      @id @default(autoincrement())
  userId      Int?     @map("user_id")
  token       String   @unique @db.VarChar(512)
  cityName    String?  @map("city_name") @db.VarChar(100)
  countryName String?  @map("country_name") @db.VarChar(100)
  timezone    String?  @db.VarChar(50)
  language    String?  @default("en") @db.VarChar(5)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

model SystemSettings {
  id                             Int       @id @default(autoincrement())
  slackWebhookUrl                String?   @map("slack_webhook_url") @db.Text
  notifyOnRegister               Boolean   @default(true) @map("notify_on_register")
  notifyOnLogin                  Boolean   @default(true) @map("notify_on_login")
  notifyOnVisit                  Boolean   @default(false) @map("notify_on_visit")
  updatedAt                      DateTime  @updatedAt @map("updated_at")
  globalLeaderboardNotifications Boolean   @default(true) @map("global_leaderboard_notifications")
  globalPrayerNotifications      Boolean   @default(true) @map("global_prayer_notifications")

  // Quiz Scheduling
  quizFrequency                  String    @default("daily") @map("quiz_frequency") @db.VarChar(20)
  quizStartTime                  String    @default("15:00") @map("quiz_start_time") @db.VarChar(5)
  quizEndTime                    String    @default("18:00") @map("quiz_end_time") @db.VarChar(5)
  quizWeeklyDay                  Int       @default(5) @map("quiz_weekly_day")
  quizMonthlyDay                 Int       @default(1) @map("quiz_monthly_day")
  quizCustomDate                 DateTime? @map("quiz_custom_date")

  @@map("system_settings")
}

model UserGoal {
  id                 Int                 @id @default(autoincrement())
  userId             Int                 @map("user_id")
  goodDeedId         Int?                @map("good_deed_id")
  customDeedName     String?             @map("custom_deed_name") @db.VarChar(200)
  goalType           String              @map("goal_type") @db.VarChar(20)
  targetCount        Int                 @default(1) @map("target_count")
  startDate          DateTime            @map("start_date") @db.Date
  endDate            DateTime            @map("end_date") @db.Date
  isCompleted        Boolean             @default(false) @map("is_completed")
  createdAt          DateTime            @default(now()) @map("created_at")
  predefinedGoodDeed PredefinedGoodDeed? @relation(fields: [goodDeedId], references: [id])
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([goodDeedId], map: "user_goals_good_deed_id_fkey")
  @@index([userId, goalType, startDate])
  @@map("user_goals")
}

model User {
  id                     Int                      @id @default(autoincrement())
  email                  String                   @unique @db.VarChar(255)
  name                   String                   @db.VarChar(100)
  phone                  String?                  @db.VarChar(20)
  image                  String?                  @db.Text
  countryId              Int?                     @map("country_id")
  divisionId             Int?                     @map("division_id")
  districtId             Int?                     @map("district_id")
  preferredLanguage      String                   @default("en") @map("preferred_language") @db.VarChar(5)
  timezone               String                   @default("Asia/Dhaka") @db.VarChar(50)
  createdAt              DateTime                 @default(now()) @map("created_at")
  updatedAt              DateTime                 @updatedAt @map("updated_at")
  cityName               String?                  @default("Dhaka") @map("city_name") @db.VarChar(100)
  countryName            String?                  @default("Bangladesh") @map("country_name") @db.VarChar(100)
  lastActiveAt           DateTime?                @map("last_active_at")
  lastLoginAt            DateTime?                @map("last_login_at")
  emailVerified          Boolean                  @default(false) @map("email_verified")
  passwordHash           String?                  @map("password_hash") @db.Text
  referralCode           String?                  @unique @map("referral_code") @db.VarChar(10)
  referredById           Int?                     @map("referred_by_id")
  lifetimePoints         Int                      @default(0) @map("lifetime_points")
  accounts               Account[]
  completedDeeds         CompletedDeed[]
  leaderboardCache       LeaderboardCache[]
  notificationPrefs      NotificationPreferences?
  prayerSettings         PrayerSettings?
  pushSubscriptions      PushSubscription[]
  userGoals              UserGoal[]
  trophies               UserTrophy[]
  referredBy             User?                    @relation("UserToReferral", fields: [referredById], references: [id])
  referrals              User[]                   @relation("UserToReferral")
  referralRewardsGiven   ReferralReward[]         @relation("ReferralGiver")
  referralRewardsEarned  ReferralReward[]         @relation("ReferralEarner")
  country                Country?                 @relation(fields: [countryId], references: [id])
  district               District?                @relation(fields: [districtId], references: [id])
  division               Division?                @relation(fields: [divisionId], references: [id])

  quizAttempts         QuizAttempt[]
  quizProfile          UserQuizProfile?
  quizLeaderboardCache QuizLeaderboardCache[]
  quizTrophies         QuizTrophy[]

  @@index([countryId, divisionId, districtId])
  @@index([districtId], map: "users_district_id_fkey")
  @@index([divisionId], map: "users_division_id_fkey")
  @@index([email])
  @@map("users")
}

model VerificationToken {
  id        Int      @id @default(autoincrement())
  email     String   @db.VarChar(255)
  token     String   @unique @db.VarChar(255)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([email])
  @@map("verification_tokens")
}

model CustomNotification {
  id             Int      @id @default(autoincrement())
  receiverEmails String   @map("receiver_emails") @db.Text
  title          String   @default("Prophet's Companion")
  content        String   @db.Text
  scheduledAt    DateTime @map("scheduled_at")
  isSent         Boolean  @default(false) @map("is_sent")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("custom_notifications")
}

model ReferralReward {
  id              Int            @id @default(autoincrement())
  referrerId      Int            @map("referrer_id")
  referredUserId  Int            @map("referred_user_id")
  type            String         @db.VarChar(20) // 'registration' | 'deed_commission'
  points          Int
  deedId          Int?           @map("deed_id")
  createdAt       DateTime       @default(now()) @map("created_at")
  referrer        User           @relation("ReferralEarner", fields: [referrerId], references: [id], onDelete: Cascade)
  referredUser    User           @relation("ReferralGiver", fields: [referredUserId], references: [id], onDelete: Cascade)
  completedDeed   CompletedDeed? @relation(fields: [deedId], references: [id])

  @@index([referrerId])
  @@index([referredUserId])
  @@index([type])
  @@map("referral_rewards")
}

model UserTrophy {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  level     Int
  monthName String   @map("month_name") @db.VarChar(100)
  monthDate DateTime @map("month_date") @db.Date
  points    Int
  awardedAt DateTime @default(now()) @map("awarded_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_trophies")
}

// ─────────────────────────────────────────
// DAILY ISLAMIC QUIZ SYSTEM
// Fully decoupled from the Good Deeds system
// ─────────────────────────────────────────

model QuizQuestion {
  id            Int          @id @default(autoincrement())
  questionBn    String       @map("question_bn") @db.Text
  questionEn    String       @map("question_en") @db.Text
  questionAr    String?      @map("question_ar") @db.Text
  optionsBn     Json         @map("options_bn")
  optionsEn     Json         @map("options_en")
  optionsAr     Json?        @map("options_ar")
  correctIndex  Int          @map("correct_index")
  explanationBn String?      @map("explanation_bn") @db.Text
  explanationEn String?      @map("explanation_en") @db.Text
  explanationAr String?      @map("explanation_ar") @db.Text
  category      String       @default("general") @db.VarChar(50)
  difficulty    String       @default("normal") @db.VarChar(20)
  isActive      Boolean      @default(true) @map("is_active")
  createdAt     DateTime     @default(now()) @map("created_at")

  quizAnswers   QuizAnswer[]

  @@index([category])
  @@index([difficulty, isActive])
  @@map("quiz_questions")
}

model QuizAttempt {
  id               Int          @id @default(autoincrement())
  userId           Int          @map("user_id")
  date             DateTime     @map("date") @db.Date
  hijriMonth       String?      @map("hijri_month") @db.VarChar(50)
  totalScore       Int          @default(0) @map("total_score")
  totalTimeTakenMs Int          @default(0) @map("total_time_taken_ms")
  streakMultiplier Float        @default(1.0) @map("streak_multiplier")
  finalScore       Int          @default(0) @map("final_score")
  questionsCount   Int          @default(3) @map("questions_count")
  correctCount     Int          @default(0) @map("correct_count")
  isBossDay        Boolean      @default(false) @map("is_boss_day")
  completedAt      DateTime?    @map("completed_at")
  createdAt        DateTime     @default(now()) @map("created_at")

  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers          QuizAnswer[]

  @@unique([userId, date])
  @@index([userId])
  @@index([hijriMonth])
  @@index([date])
  @@map("quiz_attempts")
}

model QuizAnswer {
  id            Int          @id @default(autoincrement())
  attemptId     Int          @map("attempt_id")
  questionId    Int          @map("question_id")
  selectedIndex Int          @map("selected_index")
  isCorrect     Boolean      @map("is_correct")
  timeTakenMs   Int          @map("time_taken_ms")
  pointsAwarded Int          @default(0) @map("points_awarded")
  used5050      Boolean      @default(false) @map("used_5050")

  attempt       QuizAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question      QuizQuestion @relation(fields: [questionId], references: [id])

  @@index([attemptId])
  @@map("quiz_answers")
}

model UserQuizProfile {
  id                Int       @id @default(autoincrement())
  userId            Int       @unique @map("user_id")
  currentStreak     Int       @default(0) @map("current_streak")
  maxStreak         Int       @default(0) @map("max_streak")
  totalQuizPoints   Int       @default(0) @map("total_quiz_points")
  seasonQuizPoints  Int       @default(0) @map("season_quiz_points")
  currentHijriMonth String?   @map("current_hijri_month") @db.VarChar(50)
  lifelines5050     Int       @default(1) @map("lifelines_5050")
  streakSavers      Int       @default(0) @map("streak_savers")
  lastPlayedDate    DateTime? @map("last_played_date") @db.Date

  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_quiz_profiles")
}

model QuizLeaderboardCache {
  id          Int      @id @default(autoincrement())
  userId      Int      @map("user_id")
  period      String   @db.VarChar(20)
  hijriMonth  String?  @map("hijri_month") @db.VarChar(50)
  scopeType   String   @db.VarChar(20)
  scopeId     Int      @default(0) @map("scope_id")
  totalPoints Int      @default(0) @map("total_points")
  rank        Int      @default(0)
  updatedAt   DateTime @updatedAt @map("updated_at")

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, period, hijriMonth, scopeType, scopeId])
  @@index([period, hijriMonth, scopeType, scopeId, rank])
  @@map("quiz_leaderboard_cache")
}

model QuizTrophy {
  id           Int      @id @default(autoincrement())
  userId       Int      @map("user_id")
  hijriMonth   String   @map("hijri_month") @db.VarChar(50)
  seasonPoints Int      @map("season_points")
  rank         Int
  awardedAt    DateTime @default(now()) @map("awarded_at")

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("quiz_trophies")
}
